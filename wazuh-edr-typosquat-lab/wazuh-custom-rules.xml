<group name="local,syslog,sshd,">
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="local,sysmon,powershell_stealth,">

  <rule id="100010" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)PowerShell\.EXE</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(w|windowstyle)\s+hidden</field>
    <options>no_full_log</options>
    <description>PowerShell launched with a hidden window (-WindowStyle Hidden)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100011" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)PowerShell\.EXE</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(ep|executionpolicy)\s+bypass</field>
    <options>no_full_log</options>
    <description>PowerShell launched with execution policy bypass</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100012" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)PowerShell\.EXE</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(nop|noprofile)\b</field>
    <options>no_full_log</options>
    <description>PowerShell launched with -NoProfile flag (common in scripted/automated attacks)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100013" level="13">
    <if_sid>100010,100011,100012</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(w|windowstyle)\s+hidden</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-(ep|executionpolicy)\s+bypass</field>
    <options>no_full_log</options>
    <description>High-confidence stealth PowerShell execution: hidden window combined with execution policy bypass</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

</group>

<group name="local,typosquat,threat_intel,">

  <rule id="100020" level="5">
    <decoded_as>json</decoded_as>
    <field name="domain">\.</field>
    <field name="risk_score">\d+</field>
    <options>no_full_log</options>
    <description>Typosquat scan finding: $(domain) (risk score: $(risk_score))</description>
    <mitre>
      <id>T1583.001</id>
    </mitre>
  </rule>

  <rule id="100021" level="10">
    <if_sid>100020</if_sid>
    <field name="risk_score" type="pcre2">^(5[0-9]|[6-9][0-9]|100)$</field>
    <options>no_full_log</options>
    <description>Medium-risk typosquat domain detected: $(domain) (score: $(risk_score))</description>
    <mitre>
      <id>T1583.001</id>
      <id>T1566</id>
    </mitre>
  </rule>

  <rule id="100022" level="13">
    <if_sid>100020</if_sid>
    <field name="risk_score" type="pcre2">^([7-9][0-9]|100)$</field>
    <options>no_full_log</options>
    <description>High-risk typosquat domain detected: $(domain) (score: $(risk_score)) - possible active phishing infrastructure</description>
    <mitre>
      <id>T1583.001</id>
      <id>T1566</id>
    </mitre>
  </rule>

</group>
